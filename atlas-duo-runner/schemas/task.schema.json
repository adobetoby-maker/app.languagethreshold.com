{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-duo.local/schemas/task.schema.json",
  "title": "Atlas Duo Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "repository",
    "baseline_commit",
    "mode",
    "roles",
    "objective",
    "acceptance_criteria",
    "required_checks",
    "production_approved"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^DUO-[0-9]{8}-[a-z0-9-]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "coordination_ref": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "parallel_build",
        "designer_builder",
        "crossover",
        "lead_qa",
        "dual_analysis"
      ]
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "designer": {
          "$ref": "#/$defs/agent"
        },
        "builder": {
          "$ref": "#/$defs/agent"
        },
        "reviewer": {
          "$ref": "#/$defs/agent"
        },
        "independent_a": {
          "$ref": "#/$defs/agent"
        },
        "independent_b": {
          "$ref": "#/$defs/agent"
        }
      },
      "minProperties": 2
    },
    "objective": {
      "type": "string",
      "minLength": 20
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "preview_required": {
      "type": "boolean",
      "default": true
    },
    "production_approved": {
      "const": false
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_runs": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "cost_class": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "adapter"
      ],
      "properties": {
        "provider": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "host_affinity": {
          "type": "string"
        }
      }
    }
  }
}
