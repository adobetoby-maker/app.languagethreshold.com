    "lessons": [
      {
        "n": 1,
        "title": "Greetings and your name",
        "objective": "Greet a new adult learner, exchange names politely, and hear and produce the French /ʒ/, /u/, and nasal /ɔ̃/ sounds in familiar words.",
        "focus": "Greet someone with bonjour and introduce yourself with je m’appelle. The j in je and bonjour sounds /ʒ/; ou in bonjour sounds /u/; on in bonjour is a nasal vowel /ɔ̃/ with no separate n sound. Some final consonants are silent (Paris, salut), but others are pronounced (Marc, Paul, bonjour). Use vous with an adult you have just met; save tu for familiar classmates once you agree to be informal. A woman writes enchantée with a final -e; it sounds the same as enchanté.",
        "words": [
          {
            "es": "bonjour",
            "en": "hello, good day",
            "kind": "term"
          },
          {
            "es": "bonsoir",
            "en": "good evening",
            "kind": "term"
          },
          {
            "es": "au revoir",
            "en": "goodbye",
            "kind": "term"
          },
          {
            "es": "merci",
            "en": "thank you",
            "kind": "term"
          },
          {
            "es": "je m’appelle",
            "en": "my name is",
            "kind": "term"
          },
          {
            "es": "Comment vous appelez-vous ?",
            "en": "What is your name? (polite)",
            "kind": "phrase"
          },
          {
            "es": "enchanté",
            "en": "pleased to meet you (said by a man)",
            "kind": "term"
          },
          {
            "es": "Ça va bien, merci.",
            "en": "I’m doing well, thank you.",
            "kind": "phrase"
          },
          {
            "es": "Et vous ?",
            "en": "And you? (polite)",
            "kind": "phrase"
          },
          {
            "es": "Bonne journée !",
            "en": "Have a good day!",
            "kind": "phrase"
          },
          {
            "es": "oui",
            "en": "yes",
            "kind": "term"
          },
          {
            "es": "non",
            "en": "no",
            "kind": "term"
          },
          {
            "es": "Ça va ?",
            "en": "How are you?",
            "kind": "phrase"
          },
