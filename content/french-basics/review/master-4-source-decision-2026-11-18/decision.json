  "sourceLesson": {
    "title": "Identity or current condition?",
    "objective": "Identity or current condition?: Use ser for identity, origin and characteristics.",
    "focus": "Identity or current condition?",
    "grammar": {
      "focus": "Use ser for identity, origin and characteristics. Present forms: soy, eres, es, somos, son. A profession normally has no un or una after ser.",
      "examples": [
        {
          "es": "Marta es estudiante de medicina.",
          "en": "Marta is a medical student."
        },
        {
          "es": "Hoy está cansada.",
          "en": "Today she is tired."
        }
      ]
    },
    "speaking": "Role-play Una compañera cansada with a patient classmate. Practice identity or current condition?. Use this lesson's grammar, ask a related question, answer the partner, and confirm understanding. Keep language at beginner level; explain unfamiliar words in English when asked.",
    "readerTitle": "Una compañera cansada"
  },
