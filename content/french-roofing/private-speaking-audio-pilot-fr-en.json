  "texts": [
    {
      "lessonKey": "foundation:2",
      "text": "On commence à sept heures. J’ai besoin de vingt paquets de bardeaux. Le clou fait un pouce et demi de long.",
      "sha256": "44df7b14051aae1e9b6f3fcc70e46b7dd405112ad84495dce258098e38a7e7d1",
      "textReviewed": false
    },
    {
      "lessonKey": "foundation:3",
      "text": "Attention, le toit est mouillé et glissant. Le chef, c'est Pedro.",
      "sha256": "898589b5e5e9ad4029eb2cf9c080817dab8646cfedd1ecd8e10ce5c30a4277a6",
      "textReviewed": false
    },
    {
      "lessonKey": "foundation:4",
      "text": "Chef, j'ai le casque et les gants. J'ai besoin d'un outil. Il n'y a pas de clous sur le toit.",
      "sha256": "b6d7213cb02d0f002c774f50a41a5bc4e322102718207dfaea6c332225b7f548",
      "textReviewed": false
    },
    {
      "lessonKey": "foundation:6",
      "text": "L'équipe arrive à six heures. Le matin, je cloue les bardeaux. On mange à midi.",
      "sha256": "3861ce22c682da78d38ce0a6674d5acfd0295b8972a860272d9bc378af1d44af",
      "textReviewed": false
    },
    {
      "lessonKey": "foundation:7",
      "text": "Chef, où sont les outils ? Qui dirige l'équipe ? Quand est-ce que je commence ? Où est la bâche ? Combien de clous est-ce qu'il nous faut ?",
      "sha256": "2d97ce726bf6393eb5d0797e44c4af9bd8859519d15f0f9394c3c6f69b9be788",
      "textReviewed": false
    }
  ]
}
