      },
      {
        "en": "Good morning, do I order here at the counter?",
        "es": "Buenos días, ¿pido aquí en el mostrador?",
        "kind": "phrase"
      },
      {
        "en": "Is there a free table?",
        "es": "¿Hay una mesa libre?",
        "kind": "phrase"
      },
      {
        "en": "Do I sit wherever I want?",
        "es": "¿Me siento donde quiero?",
        "kind": "phrase"
      },
      {
        "en": "Sorry, I don't understand. Can you repeat, please?",
        "es": "Perdón, no entiendo. ¿Puede repetir, por favor?",
        "kind": "phrase"
      },
      {
        "en": "Is it to go or to eat here?",
        "es": "¿Es para llevar o para comer aquí?",
        "kind": "phrase",
        "note": "Staff often ask this; you can also say it to check."
      }
    ]
  },
