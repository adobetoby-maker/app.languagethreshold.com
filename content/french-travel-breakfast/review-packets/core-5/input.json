    "reader": [
      {
        "id": "core:5:line:1",
        "targetFrench": "Un voyageur arrive dans la salle du petit-déjeuner de l'hôtel le matin.",
        "supportEnglish": "A traveler arrives at the hotel dining room in the morning."
      },
      {
        "id": "core:5:line:2",
        "targetFrench": "Il demande à la réceptionniste : « Le petit-déjeuner est-il compris ? »",
        "supportEnglish": "He talks to the receptionist: Is breakfast included?"
      },
      {
        "id": "core:5:line:3",
        "targetFrench": "Elle répond : « Oui, il est compris avec votre chambre. »",
        "supportEnglish": "She says: Yes, it is included with your room."
      },
      {
        "id": "core:5:line:4",
        "targetFrench": "Il demande : « Quels sont les horaires du petit-déjeuner ? »",
        "supportEnglish": "He asks: What are the breakfast hours?"
      },
      {
        "id": "core:5:line:5",
        "targetFrench": "Elle dit que, dans cet hôtel, le service va de 6 h 30 à 10 h.",
        "supportEnglish": "She answers that the hours are from 6:30 to 10:00, according to the hotel."
      },
      {
        "id": "core:5:line:6",
        "targetFrench": "Le voyageur donne son numéro de chambre : 214.",
        "supportEnglish": "The traveler gives his room number: 214."
      },
      {
        "id": "core:5:line:7",
        "targetFrench": "Puis il demande : « Est-ce un buffet ou un service à la carte ? »",
        "supportEnglish": "Then he asks: Is it a buffet or a menu?"
      },
      {
        "id": "core:5:line:8",
        "targetFrench": "Elle explique les consignes de ce buffet : prendre une assiette propre et ne pas emporter de nourriture.",
        "supportEnglish": "She explains the buffet rules: take a clean plate and do not take food with you."
      },
      {
        "id": "core:5:line:9",
        "targetFrench": "Il cherche une table libre et prend un café.",
        "supportEnglish": "He looks for a free table and gets coffee."
