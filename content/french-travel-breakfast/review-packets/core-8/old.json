  "readerTitleFrench": "Commander pour toute la famille",
  "reader": [
    {
      "id": "core:8:line:1",
      "targetFrench": "Je suis dans un café avec ma femme, mon fils et ma belle-mère.",
      "supportEnglish": "I am in a café with my wife, my son, and my mother-in-law."
    },
    {
      "id": "core:8:line:2",
      "targetFrench": "Je dis d'abord au serveur : « Je voudrais commander pour tout le monde, s'il vous plaît. »",
      "supportEnglish": "First, I say to the waiter: I want to order for everyone, please."
    },
    {
      "id": "core:8:line:3",
      "targetFrench": "Pour moi, un café au lait et des œufs brouillés.",
      "supportEnglish": "For me, a coffee with milk and some scrambled eggs."
    },
    {
      "id": "core:8:line:4",
      "targetFrench": "Pour ma femme, un thé et un sandwich au jambon, sans fromage.",
      "supportEnglish": "For my wife, a tea and a ham sandwich, without cheese."
    },
    {
      "id": "core:8:line:5",
      "targetFrench": "Mon fils va prendre un jus d'orange et un petit pain sucré.",
      "supportEnglish": "My son is going to have orange juice and a sweet roll."
    },
    {
      "id": "core:8:line:6",
      "targetFrench": "Ma belle-mère voudrait un café décaféiné et du pain grillé avec du beurre.",
      "supportEnglish": "My mother-in-law wants a decaf coffee and toast with butter."
    },
    {
      "id": "core:8:line:7",
      "targetFrench": "Puis je répète la commande : « C'est correct ? Le thé est pour elle, c'est bien ça ? »",
      "supportEnglish": "Then, I repeat the order: Is that correct? The tea is for her, right?"
    },
    {
      "id": "core:8:line:8",
      "targetFrench": "Le serveur sourit et dit : « Tout est correct, je vous apporte ça tout de suite. »",
      "supportEnglish": "The waiter smiles and says: Everything is right, I'll bring it right away."
    },
    {
      "id": "core:8:line:9",
      "targetFrench": "À la fin, je demande l'addition à la table.",
      "supportEnglish": "At the end, I ask for the check at the table."
    }
  ],
  "speaking": {
    "openingFrench": "Bonjour ! Je voudrais commander pour tout le monde. Pour ma femme, un thé et un sandwich sans fromage. C'est bien ça ?",
    "instructionEnglish": "Order separate breakfast items for several people and repeat who gets what before the server leaves."
  },
