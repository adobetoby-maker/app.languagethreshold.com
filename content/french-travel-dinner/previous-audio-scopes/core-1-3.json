  "texts": [
    {
      "spokenText": "Avez-vous quelque chose sans alcool ?",
      "textSHA256": "b8695ec01b2647b75261fd07de046ed2500fc92254c8375cd6134e9f2356bf62",
      "placements": [
        {
          "lessonId": "travel-dinner:3:fr-en",
          "surface": "card",
          "index": 13
        },
        {
          "lessonId": "travel-dinner:3:fr-en",
          "surface": "reader",
          "index": 5
        }
      ]
    },
    {
      "spokenText": "Bien sûr. Pour combien de personnes ?",
      "textSHA256": "63d7fe8ecb0698155979ba4a6da20aee0db4620c4062e06faee6e0d4fcf1833c",
      "placements": [
        {
          "lessonId": "travel-dinner:1:fr-en",
          "surface": "reader",
          "index": 3
        }
      ]
    },
    {
      "spokenText": "Bonsoir. J'ai une réservation au nom de Smith.",
      "textSHA256": "fa39e97e97de289518df69d392bc42dd67f6d30a7d583a51d0e6262a743c7e22",
      "placements": [
        {
          "lessonId": "travel-dinner:2:fr-en",
          "surface": "reader",
          "index": 1
        }
      ]
    },
    {
      "spokenText": "Bonsoir. Je voudrais faire une réservation pour samedi.",
      "textSHA256": "e687ba22a6417e007872c168fa56a625ddec1cd04ad3a8adfb195b116a2f4ae0",
      "placements": [
        {
          "lessonId": "travel-dinner:1:fr-en",
          "surface": "reader",
          "index": 2
        }
      ]
    },
    {
      "spokenText": "Bonsoir. Je vérifie la liste. Vous êtes un peu en avance.",
      "textSHA256": "dd7dc5925556675d31cfcf3f5d1805b182bccfb1b22c1e70a9961b1caf67eca4",
      "placements": [
        {
          "lessonId": "travel-dinner:2:fr-en",
          "surface": "reader",
          "index": 2
        }
      ]
    },
    {
      "spokenText": "Bonsoir. Vous avez une réservation ?",
      "textSHA256": "c746bcec6ee9259fb634be3c626748e827cc32bd2ebd1cb2f713b62c2dac9838",
      "placements": [
        {
          "lessonId": "travel-dinner:2:fr-en",
          "surface": "speaking-opening"
        }
      ]
    },
    {
      "spokenText": "Bonsoir. Vous souhaitez prendre un apéritif avant le dîner ?",
      "textSHA256": "5ca6c27119d6c9bcbc3094d3eaf005e86515848ed3118762a20ff34df4cf53a9",
      "placements": [
        {
          "lessonId": "travel-dinner:3:fr-en",
          "surface": "reader",
          "index": 1
        }
      ]
    },
    {
      "spokenText": "C'est au nom de Sam.",
      "textSHA256": "e200513666505a1496b659a081d84b5e933acf629669f245dc77563ffa5d7b3d",
      "placements": [
        {
          "lessonId": "travel-dinner:1:fr-en",
          "surface": "card",
          "index": 17
        }
      ]
    },
    {
      "spokenText": "C'est pour un anniversaire.",
      "textSHA256": "bfed9a76a148140b3ec994b766d1d841843a7f6bb4dbe5240bc0191cadf682ee",
      "placements": [
        {
          "lessonId": "travel-dinner:1:fr-en",
          "surface": "card",
          "index": 15
        }
      ]
    },
    {
      "spokenText": "Ce soir, nous servons des olives avec les boissons.",
      "textSHA256": "8ce10e3b55fe25b53b3e4cc1f2040789c5ce10fefadbfcf2b597783de25f4a62",
      "placements": [
        {
          "lessonId": "travel-dinner:3:fr-en",
          "surface": "reader",
          "index": 8
        }
      ]
    },
    {
      "spokenText": "Combien de temps faut-il attendre ?",
      "textSHA256": "5790b245130da8c1d360426240cf0e82ae0e639a0584128cfb77bf889e274ed2",
      "placements": [
        {
          "lessonId": "travel-dinner:2:fr-en",
          "surface": "card",
          "index": 13
        }
      ]
    },
    {
      "spokenText": "Comment se passe l'apéritif ici ?",
      "textSHA256": "bfdc7579674370f8b7e64caa55c6d295f5405803994f38e4454949644b91dc7b",
      "placements": [
        {
          "lessonId": "travel-dinner:3:fr-en",
          "surface": "card",
          "index": 16
        }
      ]
    },
    {
      "spokenText": "Est-ce que les amuse-bouches sont compris ?",
      "textSHA256": "e828febe5009b6da0849a410b6c805336f1c75053f1405b1dd6c333f13f75801",
      "placements": [
        {
          "lessonId": "travel-dinner:3:fr-en",
          "surface": "card",
          "index": 14
        },
        {
          "lessonId": "travel-dinner:3:fr-en",
          "surface": "reader",
          "index": 7
        }
      ]
    },
    {
      "spokenText": "Est-ce que vous avez une table en terrasse ?",
      "textSHA256": "451c4207c2404b33082cde1c2f877146d921bcdf29cdfb51107ee57125c76f68",
      "placements": [
        {
          "lessonId": "travel-dinner:1:fr-en",
          "surface": "card",
          "index": 13
        }
      ]
    },
    {
      "spokenText": "Excusez-moi, pourriez-vous répéter ?",
      "textSHA256": "c7a5a848ad674f1234a1293e8a5c740e7ff00f7cd8a2d30f3364acd2b1ea4cd7",
      "placements": [
        {
          "lessonId": "travel-dinner:2:fr-en",
          "surface": "card",
          "index": 16
        }
      ]
    },
    {
      "spokenText": "Il faut attendre quinze minutes. Votre table n'est pas encore prête.",
      "textSHA256": "fd3e125ea5627a612bdc6c57552997b9fd7c2eb15931e014764397eff4f06de1",
      "placements": [
        {
          "lessonId": "travel-dinner:2:fr-en",
          "surface": "reader",
          "index": 4
        }
      ]
    },
    {
      "spokenText": "J'ai une réservation au nom de Smith.",
      "textSHA256": "00125b8b0dca66b2edf0425c453df62c41c85ad04aa1839dd4a67ea0d6b861ae",
      "placements": [
        {
          "lessonId": "travel-dinner:2:fr-en",
          "surface": "card",
          "index": 12
        }
      ]
    },
    {
      "spokenText": "Je préférerais une table en terrasse.",
      "textSHA256": "443c86cb85ce1188172dc0f081e0fa5814024b543dd3b2147d5b439a7e1e83bc",
      "placements": [
        {
          "lessonId": "travel-dinner:2:fr-en",
          "surface": "card",
          "index": 17
        }
      ]
    },
    {
      "spokenText": "Je vais vérifier si elle est libre. Je vous donne ce numéro pour l'attente.",
      "textSHA256": "b4a14306ab3bc67b591ec7d4ea54117d4d93bba820c83f6f662553740e7869b3",
      "placements": [
        {
          "lessonId": "travel-dinner:2:fr-en",
          "surface": "reader",
          "index": 8
        }
      ]
    },
    {
      "spokenText": "Je vais vérifier. Il reste une table en terrasse.",
      "textSHA256": "60ca8e61b9cffff401ee2693c6ffb31ebec11a275b01ab814e74150e8fa6c929",
      "placements": [
        {
          "lessonId": "travel-dinner:1:fr-en",
          "surface": "reader",
          "index": 7
        }
      ]
    },
    {
      "spokenText": "Je voudrais faire une réservation.",
      "textSHA256": "878add127e6426798b03105281be0c9650fe9d123727487495730ebf181758a0",
      "placements": [
        {
          "lessonId": "travel-dinner:1:fr-en",
          "surface": "card",
          "index": 11
        }
      ]
    },
    {
      "spokenText": "Je voudrais un apéritif, s'il vous plaît.",
      "textSHA256": "e24a097956f36045077ec9f4c4aa07971f8bacd1dce5205ce27a93ff3d010a3d",
      "placements": [
        {
          "lessonId": "travel-dinner:3:fr-en",
          "surface": "card",
          "index": 15
        }
      ]
    },
    {
      "spokenText": "Je vous appelle dès que votre table est prête.",
      "textSHA256": "5602f39992e5749a427a0a432dbd89b39787012f37c9f23ca308a4a6b957d89a",
      "placements": [
        {
          "lessonId": "travel-dinner:2:fr-en",
          "surface": "speaking-closure"
        }
      ]
    },
    {
      "spokenText": "Merci. Je vous apporte la carte des boissons.",
      "textSHA256": "5c46af18b274e5eb67ca2bae8b20d8527d62bf931ab0af527128c3b10ee7a05e",
      "placements": [
        {
          "lessonId": "travel-dinner:3:fr-en",
          "surface": "speaking-closure"
        }
      ]
    },
    {
      "spokenText": "Merci. Nous attendrons au bar.",
      "textSHA256": "76b53241f293024639433a379baf7a0fc04b4aa291cd41d51c327fe5a2e30ec3",
      "placements": [
        {
          "lessonId": "travel-dinner:2:fr-en",
          "surface": "reader",
          "index": 9
        }
      ]
    },
    {
      "spokenText": "Nous serons quatre personnes.",
      "textSHA256": "4bad952a2886c55c31ccd19274eb551ab2f51b451bba9d047a3cb7caf6a69599",
      "placements": [
        {
          "lessonId": "travel-dinner:1:fr-en",
          "surface": "card",
          "index": 12
        }
      ]
    },
    {
      "spokenText": "Nous serons quatre personnes. C'est pour un anniversaire.",
      "textSHA256": "f992858899704a8851a279e92f86e0e210da5ed3be8ea4966a438d8224f212c9",
      "placements": [
        {
          "lessonId": "travel-dinner:1:fr-en",
          "surface": "reader",
          "index": 4
        }
      ]
    },
    {
      "spokenText": "Oui : du jus d'orange, un soda ou de l'eau gazeuse.",
