      "placements": [
        {
          "lessonId": "travel-dinner:3:fr-en",
          "surface": "reader",
          "index": 6
        }
      ]
    },
    {
      "spokenText": "Oui, bien sûr. Je vous appellerai quand la table sera prête.",
