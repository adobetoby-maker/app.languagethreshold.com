      "placements": [
        {
          "lessonId": "travel-dinner:9:fr-en",
          "surface": "card",
          "index": 17
        }
      ]
    },
    {
      "spokenText": "Pourriez-vous apporter la suite plus tard ?",
      "textSHA256": "bc575c440d3e1a40c09e1661e50d2a76208b358417870eb455715a100a4d4a6c",
      "placements": [
        {
          "lessonId": "travel-dinner:9:fr-en",
          "surface": "card",
          "index": 12
        },
        {
          "lessonId": "travel-dinner:9:fr-en",
          "surface": "reader",
          "index": 5
        }
      ]
    },
    {
