      "placements": [
        {
          "lessonId": "travel-dinner:6:fr-en",
          "surface": "card",
          "index": 15
        },
        {
          "lessonId": "travel-dinner:6:fr-en",
          "surface": "reader",
          "index": 3
        }
      ]
    },
    {
      "spokenText": "Pourriez-vous nous apporter la carte des vins ?",
      "textSHA256": "ed4190cb285d898c779b87cd640df728039aa033bcbe58da15e7f7117cec367e",
      "placements": [
        {
          "lessonId": "travel-dinner:5:fr-en",
          "surface": "reader",
          "index": 1
        }
      ]
    },
    {
      "spokenText": "Pourrions-nous commander un verre pour goûter ce vin ?",
