      "textSHA256": "e94308984e829103b876c090720de596216f71dda8c83479d6c655119b30b531",
      "placements": [
        {
          "lessonId": "travel-dinner:8:fr-en",
          "surface": "card",
          "index": 16
        }
      ]
    },
    {
