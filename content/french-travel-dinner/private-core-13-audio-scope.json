  "texts": [
    {
      "spokenText": "Bien sûr. Je vais le chercher.",
      "textSHA256": "b11eb2b4f093252dd310295e95bc38e8e4345a2576f709d10bce120b0efcf169",
      "placements": [
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "reader",
          "index": 2
        }
      ]
    },
    {
      "spokenText": "Bonsoir. Vous avez aimé votre dîner ?",
      "textSHA256": "36e995fe9eea90170f871b4b0ae6786663a87b5a26fff3e9306fd0164d29d4ed",
      "placements": [
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "speaking-opening"
        }
      ]
    },
    {
      "spokenText": "J'ai presque pleuré.",
      "textSHA256": "626696f9fbb34d7ba0f8d90225b867816588707a00e8e5b8ba0900b5d6306e16",
      "placements": [
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "card",
          "index": 17
        },
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "reader",
          "index": 6
        }
      ]
    },
    {
      "spokenText": "Je n'oublierai jamais ce goût.",
      "textSHA256": "785fce1c6797d068a7eb608baf49b0f0a3fe3f2220c0194577d6920ccfb1f4f7",
      "placements": [
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "card",
          "index": 13
        }
      ]
    },
    {
      "spokenText": "Je vais parler de ce repas à mes enfants.",
      "textSHA256": "fa1546a98e531b6816178314cd7013320cee98f2d321ebc17315e908032c70e6",
      "placements": [
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "card",
          "index": 20
        },
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "reader",
          "index": 9
        }
      ]
    },
    {
      "spokenText": "Le chef sort de la cuisine et Léa se lève de table.",
      "textSHA256": "5ab24f4bceffc5bb6713f685b9b18f07551047b3c1b47e072120e72e14d35135",
      "placements": [
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "reader",
          "index": 3
        }
      ]
    },
    {
      "spokenText": "Le goût du plat principal me rappelle la table de ma grand-mère.",
      "textSHA256": "ebd76bd8c485f41c468f44bee651a4c91dca7fdf1115dbd1eb52f8e379b890c4",
      "placements": [
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "card",
          "index": 16
        },
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "reader",
          "index": 5
        }
      ]
    },
    {
      "spokenText": "Le vin, le dessert et le service étaient parfaits.",
      "textSHA256": "d6458b59612d122e3736182029a43961da7ce69b40cfa991fe0e902ee7b92216",
      "placements": [
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "card",
          "index": 18
        },
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "reader",
          "index": 7
        }
      ]
    },
    {
      "spokenText": "Merci beaucoup pour cette soirée si spéciale.",
      "textSHA256": "6fb217e8863b813d9c13d42d2d2cd3fa3c530639c24973bdddd863e584f8cfde",
      "placements": [
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "card",
          "index": 15
        },
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "reader",
          "index": 4
        }
      ]
    },
    {
      "spokenText": "Merci à vous d'être venue.",
      "textSHA256": "ab076aef60a3b3d27a5cd3e131657f843f9da40d1515ead1df5cc04132ba67d0",
      "placements": [
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "reader",
          "index": 10
        },
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "speaking-closure"
        }
      ]
    },
    {
      "spokenText": "Pour moi, cette expérience a été incroyable.",
      "textSHA256": "cdf48fdc8c10c996bbcf67ff1f07760ac19e1e9a80bd838796c932dcb0170a5c",
      "placements": [
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "card",
          "index": 19
        },
        {
          "lessonId": "travel-dinner:13:fr-en",
          "surface": "reader",
          "index": 8
        }
      ]
    },
    {
      "spokenText": "Puis-je remercier le chef ?",
      "textSHA256": "dc79b10cfbca2954aea5c74bf4f19fbfb7e48304b883ef9c34cbdef16308fdf6",
      "placements": [
        {
          "lessonId": "travel-dinner:13:fr-en",
