  "texts": [
    {
      "spokenText": "Bien sûr, je vous apporte l'addition tout de suite.",
      "textSHA256": "2faa800194c98a32c68d5e463744fa1a87212961c3d7ddd2142cbfb8b48c5a39",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "reader",
          "index": 2
        }
      ]
    },
    {
      "spokenText": "Bonne soirée. Merci à vous.",
      "textSHA256": "ee7c56905b655a5cc91c7182a3b867331643add741aba5474671a9b3c1059329",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "speaking-closure"
        }
      ]
    },
    {
      "spokenText": "Bonsoir. Vous avez fini votre dîner ?",
      "textSHA256": "b6ea40ebe6e6ac732a0636d6f12fee3155a8fbaf2b6e6a78f7ff07d2a12a27f8",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "speaking-opening"
        }
      ]
    },
    {
      "spokenText": "Cette ligne correspond au dessert. Il n'y a pas de frais de couvert sur cette addition.",
      "textSHA256": "ddc6dc913353410704c7bfa3870890deb07a46d05f1ee86d631f490f2ba40fa0",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "reader",
          "index": 5
        }
      ]
    },
    {
      "spokenText": "En général, on laisse combien de pourboire ?",
      "textSHA256": "753fa15cc9553faa1c7d9e719a6541e14bab88de70f72fb765dd66ec1715d88f",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "card",
          "index": 15
        },
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "reader",
          "index": 8
        }
      ]
    },
    {
      "spokenText": "Gardez la monnaie.",
      "textSHA256": "eb2a157ac1fc352e977721e5ec546ba4723bab8001bb4d702503514b50068502",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "card",
          "index": 17
        }
      ]
    },
    {
      "spokenText": "Je garde le ticket après avoir payé.",
      "textSHA256": "60a11b71872aa4a2e419795e82b9eb3aeb5895beecb2c56be797cf257848d6b9",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "card",
          "index": 20
        }
      ]
    },
    {
      "spokenText": "Je laisse un petit pourboire en espèces parce que le service était excellent.",
      "textSHA256": "3acfee79bd4f65c52552ba1f7180b6ecc7ab3b5b14c7fc51b20f8d3f383b48ca",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "card",
          "index": 19
        }
      ]
    },
    {
      "spokenText": "Je voudrais payer par carte de crédit.",
      "textSHA256": "0d15a1b88e390d3d17dcf384a97344a4a6f5ae0065195f503917718acea5b842",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "card",
          "index": 16
        },
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "reader",
          "index": 10
        }
      ]
    },
    {
      "spokenText": "Le client regarde le total sur l'addition.",
      "textSHA256": "cb07e03d2dc528a6cc2d7d3219d2b060869d757afd4cba060f62942ddbcaae3e",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "reader",
          "index": 3
        }
      ]
    },
    {
      "spokenText": "Le service est-il déjà compris ?",
      "textSHA256": "4cc3ebfacd391fb61e04ffd3573478cb7ce2cf89f6f91fbfd78a8bfe835ace35",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "card",
          "index": 13
        },
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "reader",
          "index": 6
        }
      ]
    },
    {
      "spokenText": "Le service était excellent, merci beaucoup.",
      "textSHA256": "96c7c14703b1513abd036bd171ca84c3fa9e9f52b8db64f884f54b24d36f2835",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "card",
          "index": 18
        }
      ]
    },
    {
      "spokenText": "Le service était excellent, merci beaucoup. Je laisse un petit pourboire en espèces et je garde le ticket. Merci pour ce dîner inoubliable.",
      "textSHA256": "37bbe4d6587f451b17aa9c53b17c44d79beda27eabe8321b5655e5933db96e8a",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "reader",
          "index": 12
        }
      ]
    },
    {
      "spokenText": "Merci pour ce dîner inoubliable.",
      "textSHA256": "366e954a164550ec79eccbde89b2db7e067a29d9c746f2ab21d8990d6d71f792",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "card",
          "index": 21
        }
      ]
    },
    {
      "spokenText": "Oui, le service est compris dans l'addition.",
      "textSHA256": "ba53264e0080c08af41ced467920aeff863e4273a890bf4b306fa8e283a62b8b",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "reader",
          "index": 7
        }
      ]
    },
    {
      "spokenText": "Pourriez-vous vérifier cette ligne, s'il vous plaît ?",
      "textSHA256": "35ce10e2c7560bbe5a3d6d6401d98290083e546c9d665dcebe33f457515b6c20",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "card",
          "index": 14
        }
      ]
    },
    {
      "spokenText": "Pourriez-vous vérifier cette ligne, s'il vous plaît ? Y a-t-il des frais de couvert ?",
      "textSHA256": "6900fdb230dab09b23f4c081a0d24834d091864e0667edb3cd7d5de0d1777006",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "reader",
          "index": 4
        }
      ]
    },
    {
      "spokenText": "Très bien. Je vous apporte le terminal de paiement.",
      "textSHA256": "0cec7c4cb5c5d39bdedc556d65d1e5564cd045274c6c0f7fb5d94f3ebc078a70",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "reader",
          "index": 11
        }
      ]
    },
    {
      "spokenText": "Un petit pourboire est apprécié, mais il n'est pas obligatoire.",
      "textSHA256": "edf0927123b729c12ac0329fd37b325a1aa92e5b11fc1fbf2d7787d4e16a40c9",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
          "surface": "reader",
          "index": 9
        }
      ]
    },
    {
      "spokenText": "en espèces",
      "textSHA256": "04a37473f81a360c62fd7b56091e680b81beca33b2142a49cd62f879c2e44ba8",
      "placements": [
        {
          "lessonId": "travel-dinner:14:fr-en",
