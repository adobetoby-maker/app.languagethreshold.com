          "index": 1
        }
      ]
    },
    {
      "spokenText": "le plat typique",
      "textSHA256": "c32cf5b25d1d05c2a8a5a8e680c695b8adf14c209d909c711f386a5e63b94f59",
      "placements": [
        {
          "lessonId": "travel-dinner:23:fr-en",
          "surface": "card",
          "index": 9
        }
      ]
    },
    {
      "spokenText": "le restaurant familial",
      "textSHA256": "adee0647171db330599f370ba6ea0e2fcbf117b3997e99f12b75da7ced0a8e6d",
      "placements": [
        {
