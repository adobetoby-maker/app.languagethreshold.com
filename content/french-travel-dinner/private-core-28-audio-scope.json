      "placements": [
        {
          "lessonId": "travel-dinner:28:fr-en",
          "surface": "card",
          "index": 3
        }
      ]
    },
    {
      "spokenText": "les plats",
      "textSHA256": "16ba0a0ffecfa884114cedcc2e3479b9b713257bbad84bb87e5e126c0372502a",
