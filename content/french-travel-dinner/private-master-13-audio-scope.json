    {
      "spokenText": "le rapport d'incident",
      "textSHA256": "d5b2dd83b98371f2b20344d92b8a7e290c79e206752b98a7550f1ddd81fc1810",
      "placements": [
        {
          "lessonId": "master-travel-dinner:13:fr-en",
