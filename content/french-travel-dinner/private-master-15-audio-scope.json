          "surface": "reader",
          "index": 3
        }
      ]
    },
    {
      "spokenText": "Álvaro : Il y a un petit incendie dans la cuisine. Laissez tout et suivez-moi vers la sortie de secours.",
      "textSHA256": "3d12821c533f47a7b8c80f8be360ddfea7cc37f73f7d4f81aed74312d8ab72ac",
      "placements": [
        {
          "lessonId": "master-travel-dinner:15:fr-en",
          "surface": "speaking-opening"
        }
      ]
    },
