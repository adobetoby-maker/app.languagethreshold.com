        }
      ]
    },
    {
      "spokenText": "Pourriez-vous apposer le cachet et votre signature sur mon exemplaire, s'il vous plaît ?",
      "textSHA256": "39507add14824175c13f902406b6d0a37a0ae3919823c0ae74f7382aedbb7824",
      "placements": [
        {
          "lessonId": "master-travel-dinner:16:fr-en",
          "surface": "card",
          "index": 23
        }
      ]
    },
    {
      "spokenText": "Si elle ne reçoit pas le remboursement dans ce délai, Emma portera son exemplaire au service de la consommation de Málaga.",
      "textSHA256": "ec868f62393c91b3bbd3057101ce4dad68a2e6a701c860e417122f08439fd0a3",
      "placements": [
        {
          "lessonId": "master-travel-dinner:16:fr-en",
          "surface": "reader",
          "index": 18
        }
      ]
    },
