      "textSHA256": "c295cd949902ed2cb07cde66ae0a144ca840a4699c081f2c8ea12445c0c63d0b",
      "placements": [
        {
          "lessonId": "master-travel-dinner:19:fr-en",
          "surface": "card",
          "index": 20
        }
      ]
    },
    {
      "spokenText": "Nous accepterions la salle à condition que vous placiez un paravent devant.",
      "textSHA256": "fbd2c84ea3a7a415083106b8ce7052e4033498a34d003e1f418cc066f5428d24",
      "placements": [
        {
          "lessonId": "master-travel-dinner:19:fr-en",
