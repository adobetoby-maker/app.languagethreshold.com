      "textSHA256": "2a523f4f01f3d997f0862f42faed8fa3487b5fb8be2bfdc602ff0f8f259e3cf9",
      "placements": [
        {
          "lessonId": "master-travel-dinner:3:fr-en",
          "surface": "reader",
          "index": 11
        }
      ]
    },
    {
