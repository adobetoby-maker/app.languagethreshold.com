      "textSHA256": "cec75bc775a304daecc6761c293d9af45ee01891469f07342e6297bb9761722e",
      "placements": [
        {
          "lessonId": "master-travel-dinner:3:fr-en",
          "surface": "card",
          "index": 19
        }
      ]
    },
    {
