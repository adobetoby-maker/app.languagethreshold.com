    {
      "lessonNumber": 1,
      "sourceTermFace": {
        "japanese": "いっしょに",
        "english": "together"
      },
      "entryKind": "lesson-sense-context-link",
      "contextualGlossEnglish": "together (doing an activity jointly)",
      "explanationJapanese": "いっしょに は、ほかの ひとと おなじ ことを する ときに つかいます。ここでは「べんきょうしましょう」の まえに あって、あいて を べんきょう に さそって います。「らいしゅうも いっしょに べんきょうする つもりです」では、よてい を いって います。",
      "explanationEnglish": "In this lesson, いっしょに means doing an activity jointly with someone. In the dialogue it comes before べんきょうしましょう in an invitation to study. In the extension it comes before べんきょうする つもりです in a statement of intention.",
      "readerExample": {
        "sourceKind": "dialogue",
        "japanese": "では、いっしょに べんきょうしましょう。",
        "english": "Then let us study together.",
        "sourceTurnOneBased": 10,
        "selectedJapanese": null,
        "audioScript": null,
        "reviewed": false
      },
      "usageNoteEnglish": "In dialogue turn 10 and extension 4, いっしょに comes directly before the study verb. In turn 10 it combines with ～ましょう to propose a shared activity; in extension 4 it combines with ～つもりです to state a shared plan.",
      "internalQuestions": [
        "Bind as a same-lesson context link to existing sense ID ja-en-0ffe84778706be61; do not create a duplicate headword.",
        "Keep the existing global gloss 'together' and the example 'いっしょに べんきょうします。' unchanged.",
        "Extension 4 (らいしゅうも いっしょに べんきょうする つもりです。) is a second same-lesson context for this sense."
      ],
