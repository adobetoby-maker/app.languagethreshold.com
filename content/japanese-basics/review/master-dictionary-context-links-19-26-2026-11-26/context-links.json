    {
      "lessonNumber": 18,
      "sourceTermFace": {
        "japanese": "でんしゃ",
        "english": "train"
      },
      "entryKind": "lesson-sense-context-link",
      "contextualGlossEnglish": "train, used here as the means of travel",
      "explanationJapanese": "「でんしゃ」は のりものを いう めいしです。この ぶんでは「でんしゃで」の「で」が、なにを つかって いったかを しめします。「まちへ」は、いく むきを しめします。のりものを しめす「で」と、いく さきを しめす「へ」を くべつして よみます。「いきました」は かこの ていねいな かたちです。",
      "explanationEnglish": "でんしゃ is the noun train. Here で in でんしゃで marks the means of travel: by train. まちへ gives the destination or direction, while いきました reports the completed trip in polite past form. The noun keeps the same lexical sense even though its grammatical role differs from a train described as delayed elsewhere.",
      "readerExample": {
        "sourceKind": "dialogue",
        "sourceTurnOneBased": 3,
        "japanese": "でんしゃで まちへ いきました。",
        "english": "We went into town by train.",
        "selectedJapanese": null,
        "audioScript": null,
        "reviewed": false
      },
      "usageNoteEnglish": "Pattern in this source: vehicle + で, destination + へ, movement verb. No new timetable or location detail is added.",
      "internalQuestions": [],
