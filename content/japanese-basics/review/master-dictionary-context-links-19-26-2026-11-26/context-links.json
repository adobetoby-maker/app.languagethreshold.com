    {
      "lessonNumber": 18,
      "sourceTermFace": {
        "japanese": "きょうと",
        "english": "Kyoto"
      },
      "entryKind": "lesson-proper-name-context-link",
      "contextualGlossEnglish": "Kyoto, the named destination of the outing",
      "explanationJapanese": "「きょうと」は、この ぶんに でて くる ばしょの なまえです。「きょうとへ」の「へ」は、いく むきを しめします。「きょうと」は ひとつの なまえとして よみます。「きょう」という じかんの ことばと「と」に わける ものでは ありません。この なまえが、どこへ いったかを しめします。",
      "explanationEnglish": "きょうと is the proper place name Kyoto. In きょうとへ, へ marks movement toward that named destination. The name is read as a whole, not split into きょう meaning today and a separate と.",
      "readerExample": {
        "sourceKind": "dialogue",
        "sourceTurnOneBased": 1,
        "japanese": "きのう ともだちと きょうとへ いきました。",
        "english": "Yesterday I went to Kyoto with a friend.",
        "selectedJapanese": null,
        "audioScript": null,
        "reviewed": false
      },
      "usageNoteEnglish": "The source names Kyoto as the destination but supplies no address or additional itinerary. The existing global proper-name face remains unchanged.",
      "internalQuestions": [],
