    {
      "lessonNumber": 14,
      "sourceHold": "M14-private-source-hold",
      "sourceTermFace": {
        "japanese": "さいごに",
        "english": "finally"
      },
      "entryKind": "lesson-sense-context-link",
      "contextualGlossEnglish": "finally, marking the last action in a sequence",
      "explanationEnglish": "さいごに marks the last item in a sequence and means 'finally'. In this extension it introduces the last action in the narrated account: talking with the friend and going home. The past tense belongs to the narrated event, not to さいごに; the linked global row uses it with non-past かえります.",
      "readerExample": {
        "sourceKind": "extension",
        "japanese": "さいごに ともだちと はなして、うちに かえりました。",
        "english": "Finally, I talked with my friend and went home.",
        "sourceTurnOneBased": 4,
        "selectedJapanese": null,
        "audioScript": null,
        "reviewed": false
      },
      "usageNoteEnglish": "さいごに opens the sentence and closes a sequence begun with まず and それから. In this extension it has no comma and a past verb (かえりました). In the global row example it has a comma and a non-past verb (さいごに、ごご うちに かえります。).",
      "internalQuestions": [
        "さいごに appears in the lesson terms and extension 4 but not in the dialogue turns or the supplied private card rows; is extension 4 acceptable as the reader example?"
      ],
      "explanationJapanese": "じゅんばんに ならべた うごきの なかで、いちばん あとの うごきを しめす ことばです。この れいでは、ともだちと はなして うちに かえった ことが さいごの うごきです。ここでは すぎた ことを いって いますが、「かえります」の ような ぶんにも つかえます。",
      "id": "master-japanese-basics:14:dictionary-context:c68f4a9d7c7dfdcd",
      "stableLessonKey": "master-japanese-basics:14",
