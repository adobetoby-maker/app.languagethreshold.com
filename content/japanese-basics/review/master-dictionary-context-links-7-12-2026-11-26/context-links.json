      "lessonNumber": 14,
      "sourceHold": "M14-private-source-hold",
      "sourceTermFace": {
        "japanese": "まず",
        "english": "first"
      },
      "entryKind": "lesson-sense-context-link",
      "contextualGlossEnglish": "first, marking the first action in a sequence of routine actions",
      "explanationEnglish": "まず is a sequence word meaning 'first'. Here it marks the first action of the morning routine: washing the face, followed by eating breakfast. It orders actions in time; it is not a ranking word here.",
      "readerExample": {
        "sourceKind": "dialogue",
        "japanese": "まず、かおを あらって、あさごはんを たべます。",
        "english": "First, I wash my face and eat breakfast.",
        "sourceTurnOneBased": 3,
        "selectedJapanese": null,
        "audioScript": null,
        "reviewed": false
      },
      "usageNoteEnglish": "In turn 3 まず opens the sentence and is followed by a comma. In turn 2 (あさは まず なにを しますか。) it sits after the topic with no comma. Later steps are introduced with それから and さいごに.",
      "internalQuestions": [
        "Is the existing sense 'first' on ja-en-c7e785d741ea3eaf sufficient for this sequence use, with no new row needed?"
      ],
      "explanationJapanese": "ひとつづきの うごきを じゅんばんに いう ときに、さいしょの うごきを しめす ことばです。「まず、かおを あらって、あさごはんを たべます。」では、あさの さいしょの うごきが かおを あらう ことだと わかります。そのあとに 「それから」や 「さいごに」が つづくと、じゅんばんが はっきり します。",
      "id": "master-japanese-basics:14:dictionary-context:c6d5e43dc40f498a",
      "stableLessonKey": "master-japanese-basics:14",
