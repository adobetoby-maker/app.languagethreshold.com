          "sourceTurnOneBased": 2,
          "exactFace": "「おそく なって すみません」と いいました。|I said, “Sorry I am late.”",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-va4300b09bbd51468d3df:reader:15:5b716dd2f13b03ef",
