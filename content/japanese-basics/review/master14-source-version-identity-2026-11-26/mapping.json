    "privateRoutine": {
      "versionSha256": "a4300b09bbd51468d3df0334d25debdca2248cb5099a0d9bbf2202edf31b44e6",
      "proposedVersionedReaderId": "review-ja-en-master14-va4300b09bbd51468d3df:reader",
      "readerRows": [
        {
          "indexZeroBased": 0,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 1,
          "exactFace": "ふだんは あさ しちじに おきます。|I usually get up at seven in the morning.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-va4300b09bbd51468d3df:reader:0:72ea0caf2428a567",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 1,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 2,
          "exactFace": "あさは まず なにを しますか。|What do you do first in the morning?",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-va4300b09bbd51468d3df:reader:1:b2616d8c0bd6db85",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 2,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 3,
          "exactFace": "まず、かおを あらって、あさごはんを たべます。|First, I wash my face and eat breakfast.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-va4300b09bbd51468d3df:reader:2:e225b6a821332a8c",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 3,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 4,
          "exactFace": "それから、しごとに いきます。|Then I go to work.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-va4300b09bbd51468d3df:reader:3:42646ff9e09ec35c",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 4,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 5,
          "exactFace": "しごとの あとは どう しますか。|What do you do after work?",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-va4300b09bbd51468d3df:reader:4:7a74ed6d53c8e707",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 5,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 6,
          "exactFace": "ふだんは うちに かえります。|I usually go home.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-va4300b09bbd51468d3df:reader:5:974a7850a3693a8f",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 6,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 7,
          "exactFace": "でも、きょうは えきで ともだちに あう よていです。|But today I plan to meet a friend at the station.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-va4300b09bbd51468d3df:reader:6:d5b75b65fb7c380a",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 7,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 8,
          "exactFace": "いつ あう よていですか。|When do you plan to meet?",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-va4300b09bbd51468d3df:reader:7:a86631cdf41f0673",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 8,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 9,
          "exactFace": "ごご さんじの よていです。|It is planned for three in the afternoon.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-va4300b09bbd51468d3df:reader:8:04a23aebb73bc963",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 9,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 10,
          "exactFace": "でも、でんしゃが おくれています。|But the train is delayed.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-va4300b09bbd51468d3df:reader:9:baa3f2db147fabb0",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 10,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 11,
          "exactFace": "では、あるいて えきへ いきます。|Then I will walk to the station.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-va4300b09bbd51468d3df:reader:10:2dd1a83e3d47d6f4",
          "existingRuntimeId": null
