    "mainDelayedMeeting": {
      "versionSha256": "de3ffc0b158dce08548a5215e832a1e7124483d25c435048c798d5a513ffffc4",
      "proposedVersionedReaderId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader",
      "readerRows": [
        {
          "indexZeroBased": 0,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 1,
          "exactFace": "きょうは えきで ともだちに あう よていです。|I plan to meet a friend at the station today.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader:0:a59bbc294a5642da",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 1,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 2,
          "exactFace": "いつ あう よていですか。|When do you plan to meet?",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader:1:a86631cdf41f0673",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 2,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 3,
          "exactFace": "ごご さんじの よていです。|It is planned for three in the afternoon.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader:2:04a23aebb73bc963",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 3,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 4,
          "exactFace": "でも、でんしゃが おくれています。|But the train is delayed.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader:3:baa3f2db147fabb0",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 4,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 5,
          "exactFace": "では、あるいて えきへ いきます。|Then I will walk to the station.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader:4:2dd1a83e3d47d6f4",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 5,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 6,
          "exactFace": "ともだちに メッセージを かきますか。|Will you write a message to your friend?",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader:5:99bf18f79f6b6094",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 6,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 7,
          "exactFace": "はい、「すこし おそく なります」と かきます。|Yes, I will write, “I will be a little late.”",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader:6:769bdaea0e175317",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 7,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 8,
          "exactFace": "それは いいですね。|That is good.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader:7:1f8e9a1ca1d82406",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 8,
          "sourceKind": "dialogue",
          "sourceTurnOneBased": 9,
          "exactFace": "そのあと えきに つきました。ともだちは まっていました。|After that, I arrived at the station. My friend was waiting.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader:8:f6669a49e852d96d",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 9,
          "sourceKind": "extension",
          "sourceTurnOneBased": 1,
          "exactFace": "あるいて えきへ いきました。|I walked to the station.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader:9:b1b24aa7f0dccafd",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 10,
          "sourceKind": "extension",
          "sourceTurnOneBased": 2,
          "exactFace": "すこし おそく なりました。|I was a little late.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader:10:d13cfe541b779fc4",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 11,
          "sourceKind": "extension",
          "sourceTurnOneBased": 3,
          "exactFace": "ともだちは えきの まえで まっていました。|My friend was waiting in front of the station.",
          "proposedVersionedReaderFaceId": "review-ja-en-master14-vde3ffc0b158dce08548a:reader:11:2f34ec356fd3cc7e",
          "existingRuntimeId": null
        },
        {
          "indexZeroBased": 12,
          "sourceKind": "extension",
          "sourceTurnOneBased": 4,
          "exactFace": "さんじはんに ともだちに あいました。|I met my friend at three thirty.",
