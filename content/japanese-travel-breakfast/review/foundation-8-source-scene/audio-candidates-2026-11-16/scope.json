      "kind": "card",
      "lessonKey": "foundation:8"
    },
    {
      "text": "コーヒーをもう一杯お願いします。",
      "textSha256": "56ec4632239b28041c0a2a87152d296a4ddeacc20aa8419e28b289bffa7f89a6",
