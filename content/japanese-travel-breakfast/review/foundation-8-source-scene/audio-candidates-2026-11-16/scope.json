      "placementId": "foundation-travel-breakfast:8:ja-en:reader:source-scene-v1:ask-ready",
      "placementSha256": "54e8184d38884e219593f8ad9f77dfe0ad42cecfad0f5264cc13bc905c10f44e",
      "kind": "reader",
      "lessonKey": "foundation:8"
    },
    {
      "text": "まだ決まっていません。",
