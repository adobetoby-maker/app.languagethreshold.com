          "surface": "card",
          "index": 20
        }
      ]
    },
    {
      "displayText": "これからもよろしくお願いします。乾杯！",
      "spokenText": "これからもよろしくお願いします。乾杯！",
      "textSHA256": "e7d0661033472d5f4589bc42e1eee7f98258a4f0b7d4dd6de117315bfe52cb18",
