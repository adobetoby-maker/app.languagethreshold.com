  "texts": [
    {
      "displayText": "「それに、両親は食後のおしゃべりが好きだから、デザートのすぐあとに帰らないでね」。",
      "spokenText": "「それに、両親は食後のおしゃべりが好きだから、デザートのすぐあとに帰らないでね」。",
      "textSHA256": "772d5a87e8bea15922317498f5ee545f0240333be1c271b6aa247454fad8ab3a",
      "placements": [
        {
          "lessonId": "travel-dinner:27:ja-en",
          "surface": "reader",
          "index": 8
        }
      ]
    },
    {
      "displayText": "いろいろ教えてくれて、ありがとう。",
      "spokenText": "いろいろ教えてくれて、ありがとう。",
      "textSHA256": "fad179adda5fb054d945fe8c7921573610dd3095eb953efaadd5a7205f8264ea",
      "placements": [
        {
          "lessonId": "travel-dinner:27:ja-en",
          "surface": "speaking-closure"
        }
      ]
    },
    {
      "displayText": "うちの家族では、15分遅れて来るのが普通だよ。",
      "spokenText": "うちの家族では、15分遅れて来るのが普通だよ。",
      "textSHA256": "f9e66ad286f824c70ce221e56722e1965e79de20c25c983440c85250c2a34a2c",
      "placements": [
        {
          "lessonId": "travel-dinner:27:ja-en",
          "surface": "card",
          "index": 20
        }
      ]
    },
    {
      "displayText": "お招きいただき、ありがとうございます。",
      "spokenText": "お招きいただき、ありがとうございます。",
      "textSHA256": "036a99d56f1d0567f3f8d338a5a058761e64c1268ffcd3ef0e313b497ff06b60",
      "placements": [
        {
          "lessonId": "travel-dinner:27:ja-en",
          "surface": "card",
          "index": 19
        }
      ]
    },
    {
      "displayText": "ご両親",
      "spokenText": "ご両親",
