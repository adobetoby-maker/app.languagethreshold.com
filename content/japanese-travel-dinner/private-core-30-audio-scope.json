      "placements": [
        {
          "lessonId": "travel-dinner:30:ja-en",
          "surface": "reader",
          "index": 8
        }
      ]
    },
    {
      "displayText": "シェフに確認いたしました。こちらの料理にはピーナッツは入っておりません。",
      "spokenText": "シェフに確認いたしました。こちらの料理にはピーナッツは入っておりません。",
