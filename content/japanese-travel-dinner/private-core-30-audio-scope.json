          "lessonId": "travel-dinner:30:ja-en",
          "surface": "reader",
          "index": 1
        }
      ]
    },
    {
      "displayText": "クララは感じよく答えます。「いえ、大丈夫です。ハウスワインのほうがいいです」",
      "spokenText": "クララは感じよく答えます。「いえ、大丈夫です。ハウスワインのほうがいいです」",
