      "placements": [
        {
          "lessonId": "master-travel-dinner:11:ja-en",
          "surface": "reader",
          "index": 4
        }
      ]
    },
    {
      "displayText": "ウォルター、20分後にここに残るかどうか決めよう。",
      "spokenText": "ウォルター、20分後にここに残るかどうか決めよう。",
