      "placements": [
        {
          "lessonId": "master-travel-dinner:11:ja-en",
          "surface": "card",
          "index": 17
        }
      ]
    },
    {
      "displayText": "ウェイターのネルがやって来て、厨房の注文が50分遅れていると説明する。",
      "spokenText": "ウェイターのネルがやって来て、厨房の注文が50分遅れていると説明する。",
