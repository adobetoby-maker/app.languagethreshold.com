          "lessonId": "master-travel-dinner:11:ja-en",
          "surface": "card",
          "index": 10
        }
      ]
    },
    {
      "displayText": "みんなに約束するよ。カチョポは待つだけの価値があるから。",
      "spokenText": "みんなに約束するよ。カチョポは待つだけの価値があるから。",
