          "surface": "reader",
          "index": 18
        }
      ]
    },
    {
      "displayText": "ジュンのマフラーに、もう少しで火がつくところだった。",
      "spokenText": "ジュンのマフラーに、もう少しで火がつくところだった。",
      "textSHA256": "d85273bedf24bf170ddd01ca657e4e50dae81c7c8c95ddadf9d730b9fdca69f2",
      "placements": [
