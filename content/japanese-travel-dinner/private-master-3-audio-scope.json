      "placements": [
        {
          "lessonId": "master-travel-dinner:3:ja-en",
          "surface": "card",
          "index": 19
        }
      ]
    },
    {
      "displayText": "ぶどうのつる枝（火にくべる）",
      "spokenText": "ぶどうのつる枝（火にくべる）",
