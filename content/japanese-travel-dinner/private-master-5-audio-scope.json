        {
          "lessonId": "master-travel-dinner:5:ja-en",
          "surface": "reader",
          "index": 15
        }
      ]
    },
    {
      "displayText": "「申し訳ありませんが、今夜のご注文の記録がありません。」",
      "spokenText": "「申し訳ありませんが、今夜のご注文の記録がありません。」",
