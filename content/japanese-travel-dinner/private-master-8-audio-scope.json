          "lessonId": "master-travel-dinner:8:ja-en",
          "surface": "reader",
          "index": 12
        }
      ]
    },
    {
      "displayText": "「アロまでタクシーを呼んでいただけますか。」",
      "spokenText": "「アロまでタクシーを呼んでいただけますか。」",
