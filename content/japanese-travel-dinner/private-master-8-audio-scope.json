      "placements": [
        {
          "lessonId": "master-travel-dinner:8:ja-en",
          "surface": "reader",
          "index": 15
        }
      ]
    },
    {
      "displayText": "「このカーブの多い道を君が運転するのは勧めないよ。」",
      "spokenText": "「このカーブの多い道を君が運転するのは勧めないよ。」",
