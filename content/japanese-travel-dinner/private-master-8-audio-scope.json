      "placements": [
        {
          "lessonId": "master-travel-dinner:8:ja-en",
          "surface": "reader",
          "index": 5
        }
      ]
    },
    {
      "displayText": "「とてもおいしいですが、もう十分いただきました。」",
      "spokenText": "「とてもおいしいですが、もう十分いただきました。」",
