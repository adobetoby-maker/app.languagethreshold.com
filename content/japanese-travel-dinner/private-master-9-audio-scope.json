          "lessonId": "master-travel-dinner:9:ja-en",
          "surface": "reader",
          "index": 13
        }
      ]
    },
    {
      "displayText": "「生クリームは別添えでお出しになるのがよいと思います。」",
      "spokenText": "「生クリームは別添えでお出しになるのがよいと思います。」",
