          "lessonId": "master-travel-dinner:9:ja-en",
          "surface": "reader",
          "index": 15
        }
      ]
    },
    {
      "displayText": "「バレンティナさん、アレキペを添えたイチジクは素晴らしかったです。」",
      "spokenText": "「バレンティナさん、アレキペを添えたイチジクは素晴らしかったです。」",
