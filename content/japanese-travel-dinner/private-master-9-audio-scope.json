          "lessonId": "master-travel-dinner:9:ja-en",
          "surface": "reader",
          "index": 10
        }
      ]
    },
    {
      "displayText": "「厨房のみなさんで、塩加減を確認してみてはいかがでしょうか。」",
      "spokenText": "「厨房のみなさんで、塩加減を確認してみてはいかがでしょうか。」",
