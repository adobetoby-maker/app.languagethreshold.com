        {
          "lessonId": "master-travel-dinner:9:ja-en",
          "surface": "reader",
          "index": 14
        }
      ]
    },
    {
      "displayText": "「アヒアコは、お出しになる前に味見をなさることをおすすめします。」",
      "spokenText": "「アヒアコは、お出しになる前に味見をなさることをおすすめします。」",
