      "placements": [
        {
          "lessonId": "master-travel-dinner:9:ja-en",
          "surface": "reader",
          "index": 9
        }
      ]
    },
    {
      "displayText": "「アヒアコの塩気が、もう少しだけ控えめだといいなと思います。」",
      "spokenText": "「アヒアコの塩気が、もう少しだけ控えめだといいなと思います。」",
