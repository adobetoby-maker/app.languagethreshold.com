          "lessonId": "master-travel-dinner:9:ja-en",
          "surface": "reader",
          "index": 2
        }
      ]
    },
    {
      "displayText": "「まず、いちばん気に入ったところからお話ししましょうか。」",
      "spokenText": "「まず、いちばん気に入ったところからお話ししましょうか。」",
