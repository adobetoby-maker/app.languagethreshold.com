      "id": "master-travel-lunch:19:ja-en:form:derived-private-1",
      "readerLine": 6,
      "cardRef": "master-travel-lunch:19:ja-en:card:16",
      "ja": "金曜日にクラス全員で、またお伺いできたらとても嬉しいです。",
      "en": "We'd love to come back on Friday with the whole class.",
      "explanationEnglish": "～できたら expresses a polite hope to return on Friday; it does not claim that the booking is confirmed."
    },
    {
      "id": "master-travel-lunch:19:ja-en:form:derived-private-2",
      "readerLine": 7,
      "cardRef": "master-travel-lunch:19:ja-en:card:17",
      "ja": "全員分の席があれば、12名で伺いたいと思います。",
      "en": "There would be 12 of us, as long as there's room for everyone.",
      "explanationEnglish": "～ば makes seating for everyone the condition for the twelve-person visit."
    },
    {
      "id": "master-travel-lunch:19:ja-en:form:derived-private-3",
      "readerLine": 12,
      "cardRef": "master-travel-lunch:19:ja-en:card:19",
      "ja": "レカードに鶏のだしが入っていないのであれば、注文させていただきます。",
      "en": "We'll order it, as long as the sauce doesn't have chicken stock.",
      "explanationEnglish": "～のであれば makes the absence of chicken stock in the sauce a condition for ordering."
    },
    {
      "id": "master-travel-lunch:19:ja-en:form:derived-private-4",
      "readerLine": 14,
      "cardRef": "master-travel-lunch:19:ja-en:card:20",
      "ja": "13時に準備ができていれば、時間どおりに伺います。",
      "en": "As long as it's ready at 13:00, we'll arrive on time.",
      "explanationEnglish": "～ていれば sets 13:00 readiness as the condition for arriving on time."
    },
    {
      "id": "master-travel-lunch:19:ja-en:form:derived-private-5",
      "readerLine": 16,
      "cardRef": "master-travel-lunch:19:ja-en:card:21",
      "ja": "もしよろしければ、今日前金をお渡しします。",
      "en": "If that's all right with you, we'll leave you a deposit today.",
      "explanationEnglish": "もし～ば frames the offer to leave a deposit today as dependent on Doña Marta agreeing."
    }
  ],
