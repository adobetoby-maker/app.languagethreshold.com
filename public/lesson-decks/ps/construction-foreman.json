{"version":1,"module":"construction-foreman","language":"Pashto","nativeLanguage":"English","model":"claude-sonnet-5-5","generatedAt":"2026-10-16T02:50:10.217Z","lessons":{"1":[{"en":"carpenter","es":"نجار","kind":"term"},{"en":"electrician","es":"الیکټریشن","kind":"term"},{"en":"plumber","es":"پلمبر","kind":"term"},{"en":"helper","es":"مرستیال","kind":"term"},{"en":"foreman","es":"سرکارګر","kind":"term"},{"en":"laborer","es":"کارګر","kind":"term"},{"en":"crew","es":"ډله","kind":"term"},{"en":"safety","es":"خوندیتوب","kind":"term"},{"en":"attendance","es":"حاضري","kind":"term"},{"en":"construction site","es":"د ودانۍ ځای","kind":"term"},{"en":"Good morning, team.","es":"سهار مو پخير، ملګرو.","kind":"phrase"},{"en":"Everyone is present.","es":"ټول حاضر دي.","kind":"phrase"},{"en":"We start at 7.","es":"موږ په ۷ بجو پیلوو.","kind":"phrase","note":"Western numerals 7 may also be written; ۷ is the Pashto-Arabic numeral."},{"en":"First, safety.","es":"لومړی، خوندیتوب.","kind":"phrase"},{"en":"Who is absent today?","es":"نن څوک غیرحاضر دی؟","kind":"phrase"}],"2":[{"en":"safety","es":"ساتنه","kind":"term"},{"en":"hazard","es":"خطر","kind":"term"},{"en":"hard hat","es":"هیلمټ","kind":"term"},{"en":"scaffold","es":"سکافولډ","kind":"term","note":"Workers commonly use the English loanword."},{"en":"safety gloves","es":"د ساتنې دستکشې","kind":"term"},{"en":"safety boots","es":"د ساتنې بوټان","kind":"term"},{"en":"safety glasses","es":"د ساتنې عینکې","kind":"term"},{"en":"emergency exit","es":"د اضطراري وتلو لار","kind":"term"},{"en":"first aid kit","es":"د لومړنیو مرستو بکس","kind":"term"},{"en":"fire extinguisher","es":"د اور وژنې آله","kind":"term"},{"en":"forklift","es":"فورک لفټ","kind":"term"},{"en":"accident","es":"پېښه","kind":"term"},{"en":"Today we are working on the scaffold.","es":"نن موږ په سکافولډ کار کوو.","kind":"phrase"},{"en":"The main hazard is falling.","es":"اصلي خطر له لوړوالي نه لویدل دي.","kind":"phrase"},{"en":"To stay safe, you must wear a hard hat.","es":"د ساتنې لپاره باید هیلمټ واغوندئ.","kind":"phrase"},{"en":"Everyone must wear safety boots and gloves.","es":"ټول باید د ساتنې بوټان او دستکشې واغوندي.","kind":"phrase"},{"en":"Do you have any questions?","es":"آیا کوم پوښتنه لرئ؟","kind":"phrase"},{"en":"If there is an emergency, go to the exit.","es":"که اضطراري حالت وي، د وتلو لارې ته لاړ شئ.","kind":"phrase"}],"3":[{"en":"hammer","es":"هتوړی","kind":"term"},{"en":"saw","es":"اره","kind":"term"},{"en":"drill","es":"ډرېل","kind":"term","note":"Common loanword used on job sites."},{"en":"level","es":"لیول","kind":"term","note":"Loanword; widely used by workers."},{"en":"tape measure","es":"متر","kind":"term","note":"Workers often just say متر; فیته is also heard."},{"en":"nails","es":"کیلې","kind":"term"},{"en":"screws","es":"پیچونه","kind":"term"},{"en":"wrench","es":"پانه","kind":"term"},{"en":"screwdriver","es":"پیچکش","kind":"term"},{"en":"pliers","es":"پلاس","kind":"term"},{"en":"shovel","es":"بیلچه","kind":"term"},{"en":"ladder","es":"زینه","kind":"term"},{"en":"Bring me the circular saw.","es":"ماته ګردي اره راوله.","kind":"phrase"},{"en":"Do you have the level?","es":"ایا ستا سره لیول شته؟","kind":"phrase"},{"en":"I need the tape measure.","es":"ماته متر په کار دی.","kind":"phrase"},{"en":"Bring the hammer and nails.","es":"هتوړی او کیلې راوله.","kind":"phrase"},{"en":"Where is the drill?","es":"ډرېل چېرته دی؟","kind":"phrase"},{"en":"Bring the wrench, please.","es":"مهرباني وکړه، پانه راوله.","kind":"phrase","note":"Polite request form."}],"4":[{"en":"lumber boards","es":"تختې","kind":"term"},{"en":"nails","es":"مېخونه","kind":"term"},{"en":"screws","es":"پېچونه","kind":"term"},{"en":"cement","es":"سیمنټ","kind":"term"},{"en":"concrete","es":"کانکریټ","kind":"term"},{"en":"sand","es":"شګه","kind":"term"},{"en":"bricks","es":"خښتې","kind":"term"},{"en":"plywood","es":"پلایوډ","kind":"term"},{"en":"inch","es":"انچ","kind":"term"},{"en":"foot (measurement)","es":"فوټ","kind":"term"},{"en":"pound (weight)","es":"پاونډ","kind":"term"},{"en":"quantity","es":"مقدار","kind":"term"},{"en":"I need 20 boards of 2×4, 8 feet long.","es":"ما ته 20 تختې د 2×4، اوږدوالی یې 8 فوټه، په کار دي.","kind":"phrase"},{"en":"Also 50 pounds of 3-inch nails.","es":"همدارنګه 50 پاونډه د 3 انچه مېخونه هم په کار دي.","kind":"phrase"},{"en":"I need 10 bags of cement.","es":"ما ته 10 کڅوړې سیمنټ په کار دي.","kind":"phrase"},{"en":"What size is this?","es":"دا څومره اندازه دی؟","kind":"phrase"},{"en":"When can you deliver the materials?","es":"تاسو دا مواد کله رسولی شئ؟","kind":"phrase"},{"en":"Please confirm the order.","es":"مهرباني وکړئ سپارښتنه تایید کړئ.","kind":"phrase"}],"5":[{"en":"plan (blueprint)","es":"نقشه","kind":"term"},{"en":"wall","es":"دېوال","kind":"term"},{"en":"door","es":"دروازه","kind":"term"},{"en":"window","es":"کړکۍ","kind":"term"},{"en":"room","es":"خونه","kind":"term"},{"en":"corner","es":"کونج","kind":"term"},{"en":"measurement","es":"اندازه","kind":"term"},{"en":"north","es":"شمال","kind":"term"},{"en":"south","es":"جنوب","kind":"term"},{"en":"east","es":"ختيځ","kind":"term"},{"en":"west","es":"لوېديځ","kind":"term"},{"en":"The wall goes from point A to point B.","es":"دېوال له A نقطې څخه B نقطې ته ځي.","kind":"phrase"},{"en":"The door is 90 centimeters wide and is 50 centimeters from the corner.","es":"دروازه 90 سانتي‌متره پلنه ده او له کونج څخه 50 سانتي‌متره لرې ده.","kind":"phrase"},{"en":"The window is 1 meter from the north wall.","es":"کړکۍ له شمالي دېوال څخه 1 متر لرې ده.","kind":"phrase"},{"en":"Measure again from the east wall.","es":"له ختيځ دېوال څخه بيا اندازه وکړئ.","kind":"phrase"},{"en":"Check the plan before you start.","es":"مخکې له پيل څخه نقشه وګورئ.","kind":"phrase"}],"6":[{"en":"hammer","es":"هتوړه","kind":"term"},{"en":"nail","es":"کیل","kind":"term"},{"en":"saw","es":"اره","kind":"term"},{"en":"screw","es":"پیچ","kind":"term"},{"en":"screwdriver","es":"پیچ کش","kind":"term"},{"en":"drill","es":"ډرېل","kind":"term"},{"en":"tape measure","es":"فیته","kind":"term","note":"Common worker word; میتر is also heard."},{"en":"level","es":"لیول","kind":"term","note":"Loanword used on job sites."},{"en":"beam","es":"بیم","kind":"term","note":"Loanword used on job sites."},{"en":"wood","es":"لرګی","kind":"term"},{"en":"wall","es":"دیوال","kind":"term"},{"en":"Measure twice, cut once.","es":"دوه ځله اندازه کوه، یو ځل غوڅ کړه.","kind":"phrase"},{"en":"Nail it here.","es":"دلته یې کیل کړه.","kind":"phrase"},{"en":"Level it.","es":"لیول یې کړه.","kind":"phrase"},{"en":"Screw it in.","es":"پیچ یې کړه.","kind":"phrase"},{"en":"Hold the beam while I cut.","es":"بیم ونیسه تر څو زه غوڅ کړم.","kind":"phrase"},{"en":"Careful!","es":"پام کوه!","kind":"phrase"}],"7":[{"en":"roof","es":"چت","kind":"term"},{"en":"beam","es":"تير","kind":"term"},{"en":"OSB board","es":"OSB تخته","kind":"term","note":"Workers usually say the letters OSB as-is."},{"en":"eave","es":"د چت څنډه","kind":"term","note":"Literally 'roof edge'."},{"en":"waterproofing","es":"د اوبو ضد پوښ","kind":"term"},{"en":"shingles","es":"شینګل","kind":"term","note":"Common loanword on job sites."},{"en":"nails","es":"مېخونه","kind":"term"},{"en":"hammer","es":"هتوړی","kind":"term"},{"en":"ladder","es":"زینه","kind":"term"},{"en":"safety harness","es":"د خوندیتوب کمربند","kind":"term"},{"en":"Install the OSB on the roof, starting from the edge.","es":"OSB تختې په چت کې له څنډې نه پیل کړئ او نصب یې کړئ.","kind":"phrase"},{"en":"Install the shingles, starting from the bottom.","es":"شینګلونه له ښکتنۍ برخې نه پیل کړئ او نصب یې کړئ.","kind":"phrase"},{"en":"Put on your safety harness.","es":"خپل د خوندیتوب کمربند وتړئ.","kind":"phrase"},{"en":"Be careful, the roof is slippery.","es":"ځان وساتئ، چت لغزنده دی.","kind":"phrase"},{"en":"Bring the ladder here.","es":"زینه دلته راوړئ.","kind":"phrase"}],"8":[{"en":"concrete","es":"کانکریټ","kind":"term"},{"en":"mix","es":"مصالحه","kind":"term","note":"General word for a mix of building materials; used for concrete mix."},{"en":"form (formwork)","es":"قالب","kind":"term"},{"en":"rebar","es":"سیخ","kind":"term","note":"Workers may also say \"اوسپنه\" (iron/steel); meaning is clear from context."},{"en":"vibrator","es":"ویبریټر","kind":"term"},{"en":"foundation","es":"بنسټ","kind":"term"},{"en":"to level","es":"برابرول","kind":"term"},{"en":"mark","es":"نښه","kind":"term"},{"en":"wet","es":"لوند","kind":"term"},{"en":"to pour","es":"اچول","kind":"term"},{"en":"setting (hardening)","es":"ټینګېدل","kind":"term"},{"en":"Start the pour.","es":"کانکریټ اچول پیل کړه.","kind":"phrase"},{"en":"Fill the form up to the mark.","es":"قالب تر نښې پورې ډک کړه.","kind":"phrase"},{"en":"Use the vibrator here.","es":"دلته ویبریټر وکاروه.","kind":"phrase"},{"en":"Level the concrete.","es":"کانکریټ برابر کړه.","kind":"phrase"},{"en":"Cover it and keep it wet for 7 days.","es":"پټ یې کړه او 7 ورځې یې لوند وساته.","kind":"phrase"}],"9":[{"en":"problem","es":"ستونزه","kind":"term"},{"en":"report","es":"راپور","kind":"term"},{"en":"injury","es":"ټپ","kind":"term"},{"en":"hazard","es":"خطر","kind":"term"},{"en":"wrong measurement","es":"غلط اندازه","kind":"term"},{"en":"missing material","es":"ورک شوي مواد","kind":"term"},{"en":"hard hat","es":"سخت خولی","kind":"term"},{"en":"scaffold","es":"سکافولډ","kind":"term"},{"en":"blueprint","es":"نقشه","kind":"term"},{"en":"inspection","es":"تفتیش","kind":"term"},{"en":"first aid","es":"لومړنۍ مرسته","kind":"term"},{"en":"supervisor","es":"سرپرست","kind":"term"},{"en":"Tell me what happened.","es":"راته ووایه چې څه پیښ شول؟","kind":"phrase"},{"en":"When did you notice the problem?","es":"ستونزه دې کله ولیدله؟","kind":"phrase"},{"en":"What did you do?","es":"تا څه وکړل؟","kind":"phrase"},{"en":"Good. Now do this.","es":"ښه ده، اوس دا کار وکړه.","kind":"phrase"},{"en":"Are you hurt?","es":"ته ټپي شوی یې؟","kind":"phrase"},{"en":"Stop work and stay away from there.","es":"کار بند کړه او له هغه ځایه لرې شه.","kind":"phrase"}],"10":[{"en":"foot (unit)","es":"فوټ","kind":"term","note":"Plural after a number: فوټه"},{"en":"inch","es":"انچ","kind":"term","note":"Plural after a number: انچه"},{"en":"meter","es":"متر","kind":"term"},{"en":"centimeter","es":"سانتي متر","kind":"term"},{"en":"square","es":"مربع","kind":"term"},{"en":"area","es":"مساحت","kind":"term"},{"en":"volume","es":"حجم","kind":"term"},{"en":"length","es":"اوږدوالی","kind":"term"},{"en":"width","es":"پلنوالی","kind":"term"},{"en":"height","es":"لوړوالی","kind":"term"},{"en":"Eight feet six inches.","es":"اته فوټه او شپږ انچه.","kind":"phrase"},{"en":"Two by four inches.","es":"دوه په څلور انچه.","kind":"phrase"},{"en":"The wall is ten feet high.","es":"دیوال لس فوټه لوړ دی.","kind":"phrase"},{"en":"The room area is twenty square meters.","es":"د خونې مساحت شل مربع متره دی.","kind":"phrase"},{"en":"How long is this beam?","es":"دا بیم څومره اوږد دی؟","kind":"phrase"},{"en":"How wide is the door?","es":"دروازه څومره پلنه ده؟","kind":"phrase"}],"11":[{"en":"schedule","es":"مهال ویش","kind":"term"},{"en":"morning","es":"سهار","kind":"term"},{"en":"afternoon","es":"ماسپښین","kind":"term"},{"en":"lunch","es":"د غرمې ډوډۍ","kind":"term"},{"en":"break","es":"وقفه","kind":"term"},{"en":"cleanup","es":"صفایي","kind":"term"},{"en":"hour","es":"ساعت","kind":"term"},{"en":"minute","es":"دقیقه","kind":"term"},{"en":"before","es":"مخکې له","kind":"term"},{"en":"after","es":"وروسته له","kind":"term"},{"en":"crew","es":"د کار ډله","kind":"term"},{"en":"tomorrow","es":"سبا","kind":"term"},{"en":"We start pouring concrete at 7:00.","es":"موږ په 7:00 بجو کانکریټ اچول پیلوو.","kind":"phrase"},{"en":"We finish before 3:00.","es":"موږ مخکې له 3:00 بجو کار خلاصوو.","kind":"phrase"},{"en":"Lunch is at 12:00.","es":"د غرمې ډوډۍ په 12:00 بجو ده.","kind":"phrase"},{"en":"If we finish the scaffold before 2:00, then we can start cleanup.","es":"که موږ سکافولډ مخکې له 2:00 بجو بشپړ کړو، نو کولی شو صفایي پیل کړو.","kind":"phrase"},{"en":"Before leaving, clean the work area.","es":"مخکې له تلو د کار ځای پاک کړئ.","kind":"phrase"}],"12":[{"en":"electricity","es":"برېښنا","kind":"term","note":"Also means electric current in everyday speech"},{"en":"voltage","es":"ولټاژ","kind":"term"},{"en":"circuit","es":"سرکټ","kind":"term"},{"en":"switch","es":"سویچ","kind":"term"},{"en":"ground (earth wire)","es":"ارت","kind":"term","note":"Common loanword used by electricians"},{"en":"short circuit","es":"شارټ سرکټ","kind":"term"},{"en":"fuse","es":"فیوز","kind":"term"},{"en":"danger","es":"خطر","kind":"term"},{"en":"live wire","es":"ژوندی تار","kind":"term"},{"en":"insulated gloves","es":"عایق دستکشې","kind":"term"},{"en":"wire","es":"تار","kind":"term"},{"en":"Danger! Do not touch.","es":"خطر! لاس مه وروړئ.","kind":"phrase"},{"en":"Always turn off the power before work.","es":"تل مخکې له کار څخه برېښنا بنده کړئ.","kind":"phrase"},{"en":"Never touch a live wire when your hands are wet.","es":"هیڅکله ژوندي تار ته لاس مه وروړئ کله چې لاسونه مو لوند وي.","kind":"phrase"},{"en":"Wear insulated gloves.","es":"عایق دستکشې واچوئ.","kind":"phrase"},{"en":"Turn off the switch before you start.","es":"مخکې له پیل څخه سویچ بند کړئ.","kind":"phrase"},{"en":"Is the circuit off?","es":"آیا سرکټ بند دی؟","kind":"phrase"}],"13":[{"en":"drywall","es":"ډرای وال","kind":"term"},{"en":"joint compound","es":"کمپاونډ","kind":"term","note":"Loanword used on site."},{"en":"tape","es":"ټیپ","kind":"term"},{"en":"screws","es":"پیچونه","kind":"term"},{"en":"sandpaper","es":"سمباده","kind":"term"},{"en":"putty knife","es":"سپاټولا","kind":"term","note":"Loanword; the term may vary by region."},{"en":"texture","es":"ټکسچر","kind":"term"},{"en":"primer","es":"پرایمر","kind":"term"},{"en":"panel","es":"پینل","kind":"term"},{"en":"wall","es":"دیوال","kind":"term"},{"en":"ceiling","es":"چت","kind":"term"},{"en":"Hang the panel.","es":"پینل ولګوه.","kind":"phrase"},{"en":"Screw every 8 inches.","es":"هر 8 انچه وروسته پیچ ولګوه.","kind":"phrase"},{"en":"Apply tape and compound.","es":"ټیپ او کمپاونډ ولګوه.","kind":"phrase"},{"en":"Sand it when it dries.","es":"کله چې وچ شي، سمباده ورکړه.","kind":"phrase"},{"en":"Is the wall ready for primer?","es":"ایا دیوال د پرایمر لپاره تیار دی؟","kind":"phrase"}],"14":[{"en":"mistake","es":"غلطي","kind":"term"},{"en":"correction","es":"سمون","kind":"term"},{"en":"hard hat","es":"سخت خولۍ","kind":"term","note":"Workers often say «هارد هټ» too."},{"en":"scaffold","es":"سکافولډ","kind":"term","note":"Common loanword on sites."},{"en":"concrete","es":"کانکريټ","kind":"term"},{"en":"rebar","es":"سیخ","kind":"term","note":"Sites often say «سریا» or «ریبار»; «سیخ» is widely understood."},{"en":"blueprint","es":"نقشه","kind":"term"},{"en":"inspection","es":"معاینه","kind":"term"},{"en":"safety","es":"خوندیتوب","kind":"term"},{"en":"hazard","es":"خطر","kind":"term"},{"en":"permit","es":"اجازه‌لیک","kind":"term"},{"en":"Look, this is not right.","es":"وګوره، دا سم نه دی.","kind":"phrase"},{"en":"Let me show you how to fix it.","es":"زه درته ښيم چې دا څنګه سمول کیږي.","kind":"phrase"},{"en":"Please do it again like this.","es":"مهرباني وکړه، دا بیا داسې وکړه.","kind":"phrase"},{"en":"It doesn't match the blueprint.","es":"دا له نقشې سره نه جوړیږي.","kind":"phrase"},{"en":"Thank you for your work. Just one fix is needed.","es":"ستاسو د کار مننه. یوازې یو سمون پکار دی.","kind":"phrase"},{"en":"Do you understand?","es":"پوه شوې؟","kind":"phrase"}],"15":[{"en":"experience","es":"تجربه","kind":"term"},{"en":"reference","es":"حواله","kind":"term","note":"Someone who can vouch for the worker; ask for a person who knows his work. Many say 'ضامن' for a guarantor."},{"en":"wage","es":"مزدوري","kind":"term"},{"en":"hard hat","es":"هیلمټ","kind":"term","note":"Common loanword on sites."},{"en":"safety","es":"ایمني","kind":"term"},{"en":"start time","es":"د پیل وخت","kind":"term"},{"en":"parking","es":"پارکنګ","kind":"term"},{"en":"bathroom","es":"تشناب","kind":"term"},{"en":"mason","es":"معمار","kind":"term"},{"en":"carpenter","es":"ترکاڼ","kind":"term"},{"en":"electrician","es":"برېښنایي کارګر","kind":"term"},{"en":"site rules","es":"د کار ځای قوانین","kind":"term"},{"en":"Do you have experience in construction?","es":"ایا تاسو په ساختمان کې تجربه لرئ؟","kind":"phrase"},{"en":"Can you start tomorrow?","es":"ایا تاسو سبا پیل کولی شئ؟","kind":"phrase"},{"en":"The pay is per day.","es":"مزدوري په ورځ حساب کیږي.","kind":"phrase"},{"en":"Do you have references?","es":"ایا تاسو حواله لرئ؟","kind":"phrase"},{"en":"Work starts at seven in the morning.","es":"کار د سهار په اوو بجو پیلیږي.","kind":"phrase"},{"en":"You must always wear a hard hat.","es":"تاسو باید تل هیلمټ واغوندئ.","kind":"phrase"}],"16":[{"en":"subcontractor","es":"سب کنټراکټر","kind":"term","note":"Common loanword used on sites"},{"en":"foreman","es":"فورمن","kind":"term","note":"Loanword; some also say سرکارګر/سرپرست"},{"en":"crew","es":"ډله","kind":"term"},{"en":"electrician","es":"برقکار","kind":"term"},{"en":"plumber","es":"پلمبر","kind":"term"},{"en":"concrete","es":"کانکریټ","kind":"term"},{"en":"scaffold","es":"سکافولډ","kind":"term"},{"en":"permit","es":"اجازه‌لیک","kind":"term"},{"en":"inspection","es":"تفتیش","kind":"term"},{"en":"deadline","es":"وروستۍ نېټه","kind":"term"},{"en":"schedule","es":"مهالویش","kind":"term"},{"en":"Monday","es":"دوشنبه","kind":"term"},{"en":"I need you to finish the work before the next crew arrives.","es":"زه غواړم چې تاسو کار د بلې ډلې له راتلو مخکې پای ته ورسوئ.","kind":"phrase"},{"en":"Hello, I'm the foreman from our company.","es":"سلام، زه د خپلې شرکت فورمن یم.","kind":"phrase"},{"en":"We need your team here Monday at 7.","es":"موږ غواړو چې ستاسو ډله دوشنبه په ۷ بجو دلته وي.","kind":"phrase"},{"en":"Can your crew start on Monday?","es":"ایا ستاسو ډله کولی شي دوشنبه پیل کړي؟","kind":"phrase"},{"en":"When will you finish the work?","es":"تاسو به کار کله پای ته ورسوئ؟","kind":"phrase"},{"en":"Please confirm the schedule with me.","es":"مهرباني وکړئ مهالویش له ما سره تایید کړئ.","kind":"phrase"}],"17":[{"en":"order","es":"آرڈ