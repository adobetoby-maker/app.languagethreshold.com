[{"id":"seed-es-foundation-spanish-basics-lesson-1","title":"Spanish 101 foundation 1: Saludos en clase","subtitle":"Spanish with English support","language":"Spanish","targetLabel":"Spanish","flag":"🇪🇸","section":"culture","category":"Culture","available":true,"sentences":[{"target":"Hola, buenos días.","en":"Hello, good morning."},{"target":"Me llamo Ana.","en":"My name is Ana."},{"target":"Soy estudiante.","en":"I am a student."},{"target":"¿Cómo te llamas?","en":"What is your name?"},{"target":"Me llamo Luis.","en":"My name is Luis."},{"target":"Mucho gusto, Luis.","en":"Nice to meet you, Luis."}]},{"id":"seed-es-foundation-spanish-basics-lesson-2","title":"Spanish 101 foundation 2: Una mesa para estudiar","subtitle":"Spanish with English support","language":"Spanish","targetLabel":"Spanish","flag":"🇪🇸","section":"culture","category":"Culture","available":true,"sentences":[{"target":"Hay una mesa en la clase.","en":"There is a table in the classroom."},{"target":"El libro está en la mesa.","en":"The book is on the table."},{"target":"Tengo un cuaderno y una mochila.","en":"I have a notebook and a backpack."},{"target":"La mochila es azul.","en":"The backpack is blue."},{"target":"Necesito una silla.","en":"I need a chair."},{"target":"La silla está aquí.","en":"The chair is here."}]},{"id":"seed-es-foundation-spanish-basics-lesson-3","title":"Spanish 101 foundation 3: Materiales para dos","subtitle":"Spanish with English support","language":"Spanish","targetLabel":"Spanish","flag":"🇪🇸","section":"culture","category":"Culture","available":true,"sentences":[{"target":"Tengo dos libros.","en":"I have two books."},{"target":"Los libros son para la clase.","en":"The books are for the class."},{"target":"Hay tres cuadernos en la mesa.","en":"There are three notebooks on the table."},{"target":"Las sillas están aquí.","en":"The chairs are here."},{"target":"Necesitamos dos lápices.","en":"We need two pencils."},{"target":"Los lápices están en la mochila.","en":"The pencils are in the backpack."}]},{"id":"seed-es-foundation-spanish-basics-lesson-4","title":"Spanish 101 foundation 4: Un grupo nuevo","subtitle":"Spanish with English support","language":"Spanish","targetLabel":"Spanish","flag":"🇪🇸","section":"culture","category":"Culture","available":true,"sentences":[{"target":"Yo soy Ana.","en":"I am Ana."},{"target":"Tú eres Luis.","en":"You are Luis."},{"target":"Ella es Marta.","en":"She is Marta."},{"target":"Él es Pablo.","en":"He is Pablo."},{"target":"Nosotros somos estudiantes.","en":"We are students."},{"target":"Ustedes son nuestros compañeros.","en":"You are our classmates."}]},{"id":"seed-es-foundation-spanish-basics-lesson-5","title":"Spanish 101 foundation 5: Personas de la clase","subtitle":"Spanish with English support","language":"Spanish","targetLabel":"Spanish","flag":"🇪🇸","section":"culture","category":"Culture","available":true,"sentences":[{"target":"Soy estudiante de español.","en":"I am a Spanish student."},{"target":"Mi profesora es de México.","en":"My teacher is from Mexico."},{"target":"Luis es mi compañero.","en":"Luis is my classmate."},{"target":"Somos amigos.","en":"We are friends."},{"target":"La clase es pequeña.","en":"The class is small."},{"target":"Los estudiantes son amables.","en":"The students are kind."}]},{"id":"seed-es-foundation-spanish-basics-lesson-6","title":"Spanish 101 foundation 6: ¿Dónde está Ana?","subtitle":"Spanish with English support","language":"Spanish","targetLabel":"Spanish","flag":"🇪🇸","section":"culture","category":"Culture","available":true,"sentences":[{"target":"Estoy en la biblioteca.","en":"I am in the library."},{"target":"Mi libro está en la mesa.","en":"My book is on the table."},{"target":"Luis está en la clase.","en":"Luis is in the classroom."},{"target":"Estamos contentos.","en":"We are happy."},{"target":"Las sillas están cerca de la puerta.","en":"The chairs are near the door."},{"target":"La puerta está abierta.","en":"The door is open."}]},{"id":"seed-es-foundation-spanish-basics-lesson-7","title":"Spanish 101 foundation 7: La biblioteca","subtitle":"Spanish with English support","language":"Spanish","targetLabel":"Spanish","flag":"🇪🇸","section":"culture","category":"Culture","available":true,"sentences":[{"target":"Hay una biblioteca en la escuela.","en":"There is a library at the school."},{"target":"Hay mesas grandes.","en":"There are large tables."},{"target":"Hay dos ventanas.","en":"There are two windows."},{"target":"La mesa de Ana está cerca de la puerta.","en":"Ana's table is near the door."},{"target":"Hay libros en la mesa.","en":"There are books on the table."},{"target":"No hay una computadora aquí.","en":"There is no computer here."}]},{"id":"seed-es-foundation-spanish-basics-lesson-8","title":"Spanish 101 foundation 8: La lista del grupo","subtitle":"Spanish with English support","language":"Spanish","targetLabel":"Spanish","flag":"🇪🇸","section":"culture","category":"Culture","available":true,"sentences":[{"target":"Tengo dieciocho años.","en":"I am eighteen years old."},{"target":"Mi hermano tiene veinte años.","en":"My brother is twenty years old."},{"target":"Hay diez estudiantes en la clase.","en":"There are ten students in the class."},{"target":"Necesitamos once libros.","en":"We need eleven books."},{"target":"Tengo un libro y dos cuadernos.","en":"I have one book and two notebooks."},{"target":"El número de la clase es quince.","en":"The class number is fifteen."}]},{"id":"seed-es-foundation-spanish-basics-lesson-9","title":"Spanish 101 foundation 9: Antes de la clase","subtitle":"Spanish with English support","language":"Spanish","targetLabel":"Spanish","flag":"🇪🇸","section":"culture","category":"Culture","available":true,"sentences":[{"target":"¿Eres estudiante?","en":"Are you a student?"},{"target":"Sí, soy estudiante.","en":"Yes, I am a student."},{"target":"¿Está la profesora aquí?","en":"Is the teacher here?"},{"target":"No, no está aquí.","en":"No, she is not here."},{"target":"¿Tienes un libro?","en":"Do you have a book?"},{"target":"No tengo un libro hoy.","en":"I do not have a book today."}]},{"id":"seed-es-foundation-spanish-basics-lesson-10","title":"Spanish 101 foundation 10: Pedir ayuda","subtitle":"Spanish with English support","language":"Spanish","targetLabel":"Spanish","flag":"🇪🇸","section":"culture","category":"Culture","available":true,"sentences":[{"target":"Soy estudiante nuevo.","en":"I am a new student."},{"target":"Estoy en la clase de español.","en":"I am in Spanish class."},{"target":"Hay una palabra nueva en el libro.","en":"There is a new word in the book."},{"target":"No entiendo esta palabra.","en":"I do not understand this word."},{"target":"¿Puedes repetir, por favor?","en":"Can you repeat, please?"},{"target":"Sí, podemos practicar despacio.","en":"Yes, we can practice slowly."}]}]