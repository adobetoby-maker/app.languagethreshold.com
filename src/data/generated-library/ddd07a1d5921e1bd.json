[{"id":"seed-ps-market-shopping","title":"At the Market","subtitle":"Bargaining for fruit and bread","language":"Pashto","targetLabel":"پښتو","flag":"🇦🇫","section":"culture","available":true,"level":"A1","category":"Culture","sentences":[{"en":"How much are these pomegranates?","target":"دا انار په څو دي؟"},{"en":"They are one hundred afghanis per kilo.","target":"یو کیلو سل افغانۍ دی."},{"en":"That is too expensive, brother.","target":"وروره، دا ډېر ګران دی."},{"en":"For you, eighty afghanis.","target":"ستاسو لپاره اتیا افغانۍ."},{"en":"Give me two kilos, please.","target":"مهرباني وکړه دوه کیلو راکړه."},{"en":"Is the bread fresh?","target":"ډوډۍ تازه ده؟"},{"en":"It came from the oven just now.","target":"همدا اوس له تنور څخه راووتله."},{"en":"Thank you; may your business prosper.","target":"مننه؛ سوداګري دې برکت ومومه."}]}]